# ? محیط تست — این فایل هرگز نباید به دیتابیس development/production اشاره کند.
# دیتابیس تست باید یک دیتابیس جدا باشد و نامش شامل "test" باشد.
NODE_ENV=test
PORT=3999

# ⚠️ نام دیتابیس باید شامل "test" باشد، وگرنه تست‌های integration متوقف می‌شوند.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/Horizon_DB_test?schema=public

BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MS=120000

# مقادیر تست — امنیتی نیستند.
JWT_SECRET=test-secret-jwt-horizon-api-do-not-use-in-production
JWT_EXPIRES_IN=120000

SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
SUPABASE_BUCKET_CABINS=cabins_images

# SMTP در تست استفاده نمی‌شود؛ فقط برای رضایت اسکیمای env لازم است.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Horizon <no-reply@test.local>

OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_HOURS=1
OTP_VERIFICATION_TOKEN_TTL_SECONDS=600
