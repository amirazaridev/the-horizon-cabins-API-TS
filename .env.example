# ? production and development
NODE_ENV=development
PORT=3001

DATABASE_URL=example

BCRYPT_SALT_ROUNDS=10

MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MS=120000

JWT_SECRET=example
JWT_EXPIRES_IN=120000

SUPABASE_URL=example
SUPABASE_SERVICE_ROLE_KEY=example
SUPABASE_BUCKET_CABINS=cabins_images

# ? Email / OTP (SMTP گوگل)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Horizon <you@gmail.com>

OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_HOURS=1
OTP_VERIFICATION_TOKEN_TTL_SECONDS=600